# Copy this file to .env for local development (it's git-ignored).
# In production these are set as Cloud Run env vars / Secret Manager
# references -- see /docs/DEPLOYMENT.md. Nothing in this file is a real
# credential.

DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# Set to "true" only for local dev. Bypasses Firebase auth entirely and
# treats every caller as the owner. Must be "false" (or unset) on any
# deployment reachable from the internet.
DEV_MODE=false

# Firebase Auth (server-side verification)
FIREBASE_SERVICE_ACCOUNT_PATH=
# The single owner's Firebase UID, once known (see docs/DEPLOYMENT.md).
OWNER_UID=

# Firebase web config (public, not secret -- identifies the project to the
# test console's client-side SDK)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# LLM provider
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Budget guardrail (see /docs/BUDGET.md)
MONTHLY_BUDGET_INR=3500
USD_TO_INR_RATE=90
PRICE_INPUT_USD_PER_1M=3.00
PRICE_OUTPUT_USD_PER_1M=15.00

CORS_ORIGINS=*
