# Copy this file to .env for local development (it's git-ignored).
# In production these are set as Cloud Run env vars / Secret Manager
# references -- see /docs/DEPLOYMENT.md. Nothing in this file is a real
# credential.

DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# Set to "true" only for local dev. Bypasses Firebase auth entirely and
# treats every caller as the owner. Must be "false" (or unset) on any
# deployment reachable from the internet.
DEV_MODE=false

# Firebase Auth (server-side verification)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Who is allowed to use this JARVIS. Set at least one.
# OWNER_EMAIL is easiest -- you know it before deploying, and it's only
# accepted when Firebase confirms the address is verified.
OWNER_EMAIL=
# OWNER_UID is Firebase's internal user ID. Optional; you can only look it
# up after signing in once (Firebase Console -> Authentication -> Users).
OWNER_UID=

# Firebase web config (public, not secret -- identifies the project to the
# test console's client-side SDK)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- Model provider ---
# Which one answers by default: gemini | claude | mock
LLM_PROVIDER=gemini
# If the primary fails and the other provider has a key, retry with it
# automatically. The reply always says which one actually answered.
LLM_FALLBACK_ENABLED=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Budget guardrail (see /docs/BUDGET.md)
MONTHLY_BUDGET_INR=3500
USD_TO_INR_RATE=90
# Per-provider prices, USD per 1M tokens. Claude defaults are Sonnet 5's
# rates. Gemini defaults to 0 because the plan is Google's free tier -- if
# you ever enable billing on that Google project, set real numbers here or
# the budget tracker will keep reporting zero. See docs/BUDGET.md.
PRICE_CLAUDE_INPUT_USD_PER_1M=2.00
PRICE_CLAUDE_OUTPUT_USD_PER_1M=10.00
PRICE_GEMINI_INPUT_USD_PER_1M=0.00
PRICE_GEMINI_OUTPUT_USD_PER_1M=0.00

CORS_ORIGINS=*
