# Copy to .env and fill in. .env is git-ignored: it never leaves your machine.
#
#   cp .env.example .env

# --- Who is allowed in (required) ---------------------------------------
# Your Google account. Only this address can sign in.
OWNER_EMAIL=you@example.com

# The OAuth client ID from your Google Cloud console. Public, not a secret.
# You must also add http://localhost:8080 to that client's
# "Authorised JavaScript origins" -- see docs/SELF_HOSTING.md step 3.
GOOGLE_CLIENT_ID=

# --- Keeping you signed in (required) ------------------------------------
# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it: change it and every existing sign-in stops working.
SESSION_SECRET=

# --- The model (required for real answers) -------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: Claude as an automatic fallback when Gemini fails.
ANTHROPIC_API_KEY=

# ChatGPT. Optional, like the others -- JARVIS runs with any one of the
# three, and uses the rest as automatic fallbacks.
#
# Worth having a second provider for one specific reason: the Auditor
# reviews a change on a DIFFERENT model from the one that wrote it. With
# only one configured it says so, and marks the review as not independent
# rather than pretending otherwise.
OPENAI_API_KEY=
# Only if the default has been retired. The error message will say so.
# OPENAI_MODEL=gpt-4o

# --- Optional ------------------------------------------------------------
# Password for your local database. Any value; it never leaves this machine.
POSTGRES_PASSWORD=jarvis

# Set to true ONLY once JARVIS is behind HTTPS. On plain http://localhost
# a "secure" cookie is never sent back, and sign-in fails silently.
COOKIE_SECURE=false

# Budget guardrail, in rupees per month.
MONTHLY_BUDGET_INR=3500

# Long-term memory. Costs a second model call per message (after your reply,
# so it adds no waiting). Set false to switch it off.
MEMORY_FACTS_ENABLED=true

# When JARVIS may check the live web before answering, for work that
# would otherwise be answered from what the model already believed.
#   off       never search
#   optional  search when it helps; carry on if it fails  (the default)
#   required  must search -- if it cannot, say so instead of answering
#   fallback  answer from what is known; search only if that is not enough
# A single task can ask for a stricter mode than this; it cannot ask for
# a looser one than it was given.
SEARCH_POLICY=optional

# Whether JARVIS may run anything on this machine at all. Off unless you
# turn it on, and even then it can only run a fixed list of read-only
# checks on its own -- disk, memory, uptime, whether a service is up.
# Anything else is shown to you as the exact command and does not run
# until you say yes. Saying yes to one command is not saying yes to the
# next one.
COMPUTER_ACCESS=false

# A model running on your own hardware, for the cheap high-volume work.
# Anything that speaks OpenAI's chat API: Ollama, llama.cpp's server,
# LM Studio, vLLM. Empty means there is none, which is fine.
#
# The quickest version, on the server JARVIS runs on:
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull llama3.2
# then set this and restart. Cheap work goes there and costs nothing;
# standard and deep work still go to a paid model, deliberately.
# If it is switched off, cheap work goes to a paid model instead of
# failing, and the Build tab says it is not answering.
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.2
